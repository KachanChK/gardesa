<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Início | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="stylesheet" href="/css/output.css" />
    <script src="/js/dashboard-shell.js" defer></script>
</head>

<body class="min-h-screen bg-branco font-sans text-preto antialiased">
    <%
        const currentPage = 'Início'
        const recentBudgets = Array.from({ length: 6 }, () => ({
            name: 'Lorem ipsum is simply dummy text of the printing and types...',
            client: 'Eduarda Ranzani',
            value: 'R$999.999',
            createdAt: '17/07/25',
            status: 'Rascunho'
        }))

        const navItems = [
            { label: 'Início', iconDefault: '/img/icons/inicio_default.svg', iconActive: '/img/icons/inicio_active.svg', active: true, href: '/inicio', iconSize: 'size-5' },
            { label: 'Orçamentos', iconDefault: '/img/icons/orcamentos_default.svg', iconActive: '/img/icons/orcamentos_active.svg', active: false, href: '/orcamentos', iconSize: 'size-5' },
            { label: 'Clientes', iconDefault: '/img/icons/clientes_default.svg', iconActive: '/img/icons/clientes_active.svg', active: false, href: '/clientes', iconSize: 'size-5' },
            { label: 'Empresa', iconDefault: '/img/icons/empresa_default.svg', iconActive: '/img/icons/empresa_active.svg', active: false, href: '/empresa', iconSize: 'size-5' }
        ]

        const metrics = [
            { label: 'Orçamentos', value: '24', hint: '6 recentes', color: 'bg-[#d1fac8] text-[#2ed218]' },
            { label: 'Clientes', value: '18', hint: '2 novos', color: 'bg-[#fff1df] text-laranja' },
            { label: 'Rascunhos', value: '6', hint: 'em aberto', color: 'bg-[#f0f0f0] text-preto' },
            { label: 'Valor previsto', value: 'R$ 42.350', hint: 'este mês', color: 'bg-[#d1fac8] text-[#2ed218]' }
        ]
    %>

    <div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" aria-hidden="true"></div>
    <%- include('../partials/dashboard-sidebar', { navItems }) %>

    <div id="dashboard-layout" class="min-h-screen transition-[padding] duration-300 md:pl-[260px]">
        <%- include('../partials/dashboard-header', { sectionLabel: 'Dashboard', currentPage }) %>

        <main class="mx-auto flex w-full max-w-[1280px] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
            <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <h2 class="mt-1 text-2xl font-semibold leading-tight text-preto sm:text-3xl">Visão geral</h2>
                </div>
            </section>

            <section class="hidden md:grid md:grid-cols-2 md:gap-4 xl:grid-cols-4" aria-label="Resumo">
                <% metrics.forEach((metric) => { %>
                    <article class="rounded-[8px] border border-[#e2e2e2] bg-white p-5 shadow-sm">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-sm font-light text-preto/60"><%= metric.label %></p>
                                <p class="mt-3 text-2xl font-semibold leading-none text-preto"><%= metric.value %></p>
                            </div>
                            <span class="rounded-full px-3 py-1 text-xs font-medium <%= metric.color %>">
                                <%= metric.hint %>
                            </span>
                        </div>
                    </article>
                <% }) %>
            </section>

            <section id="orcamentos" class="rounded-[8px] border border-[#e2e2e2] bg-white shadow-sm">
                <div class="flex flex-col gap-3 border-b border-[#e2e2e2] px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                    <div>
                        <h2 class="text-xl font-semibold leading-tight text-preto">Orçamentos recentes</h2>
                    </div>
                    <a href="/orcamentos"
                        class="inline-flex h-9 w-fit items-center justify-center rounded-full border border-[#e2e2e2] px-4 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]">
                        Ver todos
                    </a>
                </div>

                <div class="hidden w-full overflow-x-auto md:block">
                    <div class="min-w-[1080px]">
                        <div
                            class="grid h-11 grid-cols-[minmax(380px,1.9fr)_minmax(220px,1fr)_150px_130px_130px_96px] items-center bg-[#d1fac8] px-6 text-sm font-medium text-preto">
                            <span>Nome</span>
                            <span>Cliente</span>
                            <span>Valor</span>
                            <span>Criado</span>
                            <span>Status</span>
                            <span class="sr-only">Ações</span>
                        </div>

                        <% recentBudgets.forEach((budget) => { %>
                            <div
                                class="grid min-h-[68px] grid-cols-[minmax(380px,1.9fr)_minmax(220px,1fr)_150px_130px_130px_96px] items-center border-b border-[#e2e2e2] px-6 text-sm text-preto last:border-b-0">
                                <p class="truncate pr-10 font-medium"><%= budget.name %></p>
                                <p class="truncate pr-8 font-normal"><%= budget.client %></p>
                                <p class="font-normal"><%= budget.value %></p>
                                <p class="font-normal"><%= budget.createdAt %></p>
                                <span
                                    class="flex h-[22px] w-[96px] items-center justify-center rounded-full bg-[rgba(168,165,172,0.6)] text-xs font-medium leading-none text-white shadow-[1px_1px_4px_0px_rgba(0,0,0,0.18)]">
                                    <%= budget.status %>
                                </span>
                                <div class="flex items-center justify-end gap-4 justify-self-end">
                                    <a href="#" aria-label="Baixar orçamento" class="transition-opacity hover:opacity-70">
                                        <img src="/img/icons/download_icon.svg" alt="" class="size-5" />
                                    </a>
                                    <a href="#" aria-label="Deletar orçamento" class="transition-opacity hover:opacity-70">
                                        <img src="/img/icons/deletar_icon.svg" alt="" class="size-5" />
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="flex flex-col divide-y divide-[#e2e2e2] md:hidden">
                    <% recentBudgets.forEach((budget) => { %>
                        <article class="flex flex-col gap-4 px-4 py-4">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="truncate text-sm font-semibold text-preto"><%= budget.name %></h3>
                                    <p class="mt-1 text-sm font-light text-preto/60"><%= budget.client %></p>
                                </div>
                                <span
                                    class="flex h-[22px] shrink-0 items-center justify-center rounded-full bg-[rgba(168,165,172,0.6)] px-3 text-xs font-medium leading-none text-white shadow-[1px_1px_4px_0px_rgba(0,0,0,0.18)]">
                                    <%= budget.status %>
                                </span>
                            </div>

                            <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                                <div>
                                    <p class="text-xs font-light uppercase tracking-[0.02em] text-preto/50">Valor</p>
                                    <p class="mt-1 font-medium text-preto"><%= budget.value %></p>
                                </div>
                                <div>
                                    <p class="text-xs font-light uppercase tracking-[0.02em] text-preto/50">Criado</p>
                                    <p class="mt-1 font-medium text-preto"><%= budget.createdAt %></p>
                                </div>
                            </div>

                            <div class="flex items-center justify-end gap-4">
                                <a href="#"
                                    class="inline-flex h-9 items-center justify-center rounded-full border border-[#e2e2e2] px-3 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]"
                                    aria-label="Baixar orçamento">
                                    <img src="/img/icons/download_icon.svg" alt="" class="size-4" />
                                </a>
                                <a href="#"
                                    class="inline-flex h-9 items-center justify-center rounded-full border border-[#e2e2e2] px-3 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]"
                                    aria-label="Deletar orçamento">
                                    <img src="/img/icons/deletar_icon.svg" alt="" class="size-4" />
                                </a>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>
        </main>
    </div>
</body>

</html>
