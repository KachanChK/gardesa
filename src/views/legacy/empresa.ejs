<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Empresa | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="stylesheet" href="/css/output.css" />
    <script src="/js/dashboard-shell.js" defer></script>
    <script src="/js/empresa-store.js" defer></script>
    <script src="/js/empresa.js" defer></script>
</head>

<body class="min-h-screen bg-branco font-sans text-preto antialiased">
    <%
        const currentPage = 'Empresa'
        const navItems = [
            { label: 'Início', iconDefault: '/img/icons/inicio_default.svg', iconActive: '/img/icons/inicio_active.svg', active: false, href: '/inicio', iconSize: 'size-5' },
            { label: 'Orçamentos', iconDefault: '/img/icons/orcamentos_default.svg', iconActive: '/img/icons/orcamentos_active.svg', active: false, href: '/orcamentos', iconSize: 'size-5' },
            { label: 'Clientes', iconDefault: '/img/icons/clientes_default.svg', iconActive: '/img/icons/clientes_active.svg', active: false, href: '/clientes', iconSize: 'size-5' },
            { label: 'Empresa', iconDefault: '/img/icons/empresa_default.svg', iconActive: '/img/icons/empresa_active.svg', active: true, href: '/empresa', iconSize: 'size-5' }
        ]
    %>

    <div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" aria-hidden="true"></div>
    <%- include('../partials/dashboard-sidebar', { navItems }) %>

    <div id="dashboard-layout" class="min-h-screen transition-[padding] duration-300 md:pl-[260px]">
        <%- include('../partials/dashboard-header', { sectionLabel: 'Dashboard', currentPage }) %>

        <main class="mx-auto flex w-full max-w-[1160px] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
            <h2 class="text-[28px] font-semibold leading-tight text-preto">Dados da Empresa</h2>

            <form data-company-form class="rounded-[8px] border border-[#d6d6d6] bg-white px-5 py-6 sm:px-8 sm:py-8 lg:px-12 lg:py-12" novalidate>
                <section class="flex flex-col gap-6 sm:flex-row sm:items-start">
                    <div data-company-field="logoUrl" tabindex="-1"
                        class="flex size-[124px] shrink-0 items-center justify-center overflow-hidden rounded-[8px] border border-[#e2e2e2] bg-[#fbfbfb] transition-colors">
                        <img data-company-logo-preview alt="Logo da empresa" class="hidden max-h-full max-w-full object-contain" />
                        <span data-company-logo-placeholder class="flex size-full items-center justify-center text-preto/25">
                            <svg xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                <rect x="4" y="5" width="16" height="14" rx="2" />
                                <circle cx="9" cy="10" r="1.3" />
                                <path d="M6.8 16l3.2-3.2a1.2 1.2 0 0 1 1.7 0l2.1 2.1 1.3-1.3a1.2 1.2 0 0 1 1.7 0l2.2 2.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </div>

                    <div class="min-w-0 flex-1 pt-2">
                        <h3 class="text-xl font-semibold leading-none text-preto">Foto</h3>
                        <p class="mt-4 text-sm font-light leading-relaxed text-preto/60">Isso será exibido no perfil da empresa.</p>

                        <div class="mt-5 flex flex-wrap items-center gap-3">
                            <input id="company-logo-input" type="file" data-company-logo-input
                                accept=".png,.jpg,.jpeg,image/png,image/jpeg" class="sr-only" />
                            <label for="company-logo-input" data-company-logo-trigger role="button" tabindex="0"
                                class="inline-flex h-9 cursor-pointer items-center justify-center rounded-[8px] bg-verde px-4 text-sm font-semibold text-white transition-colors hover:bg-verde-2">
                                Alterar logo
                            </label>

                            <button type="button" data-remove-company-logo
                                class="inline-flex h-9 items-center justify-center rounded-[8px] border border-[#c62828] bg-transparent px-4 text-sm font-semibold text-[#c62828] transition-colors hover:bg-[#fff5f5]">
                                Remover logo
                            </button>
                        </div>
                    </div>
                </section>

                <span data-company-error="logoUrl" class="mt-3 hidden text-sm font-medium text-[#c62828]"></span>

                <div data-company-form-message role="alert"
                    class="mt-5 hidden rounded-[8px] border px-4 py-3 text-sm font-medium leading-relaxed"></div>

                <div class="mt-10 border-t border-[#d6d6d6] pt-10">
                    <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
                        <label class="flex flex-col gap-2">
                            <span class="text-xs font-medium text-preto">Nome da empresa</span>
                            <input type="text" data-company-name data-company-field="companyName" maxlength="40"
                                class="h-11 rounded-[8px] border border-[#d6d6d6] bg-white px-4 text-sm text-preto outline-none transition-colors placeholder:text-preto/45 focus:border-verde-3"
                                placeholder="Gardesa Landscaping" autocomplete="organization" />
                            <span data-company-error="companyName" class="hidden text-sm font-medium text-[#c62828]"></span>
                        </label>

                        <label class="flex flex-col gap-2">
                            <span class="text-xs font-medium text-preto">E-mail da empresa</span>
                            <input type="email" data-company-email data-company-field="email" maxlength="80"
                                class="h-11 rounded-[8px] border border-[#d6d6d6] bg-white px-4 text-sm text-preto outline-none transition-colors placeholder:text-preto/45 focus:border-verde-3"
                                placeholder="contato@gardesa.com" autocomplete="email" />
                            <span data-company-error="email" class="hidden text-sm font-medium text-[#c62828]"></span>
                        </label>

                        <label class="flex flex-col gap-2">
                            <span class="text-xs font-medium text-preto">CNPJ</span>
                            <input type="text" data-company-cnpj data-company-field="cnpj" maxlength="18" inputmode="numeric"
                                class="h-11 rounded-[8px] border border-[#d6d6d6] bg-white px-4 text-sm text-preto outline-none transition-colors placeholder:text-preto/45 focus:border-verde-3"
                                placeholder="00.000.000/0000-00" autocomplete="off" />
                            <span data-company-error="cnpj" class="hidden text-sm font-medium text-[#c62828]"></span>
                        </label>

                        <label class="flex flex-col gap-2">
                            <span class="text-xs font-medium text-preto">Telefone</span>
                            <input type="tel" data-company-phone data-company-field="phone" maxlength="15" inputmode="numeric"
                                class="h-11 rounded-[8px] border border-[#d6d6d6] bg-white px-4 text-sm text-preto outline-none transition-colors placeholder:text-preto/45 focus:border-verde-3"
                                placeholder="(00) 00000-0000" autocomplete="tel" />
                            <span data-company-error="phone" class="hidden text-sm font-medium text-[#c62828]"></span>
                        </label>

                        <label class="flex flex-col gap-2 sm:col-span-2">
                            <span class="text-xs font-medium text-preto">Endereço</span>
                            <textarea data-company-address data-company-field="address" maxlength="150" rows="4"
                                class="min-h-[116px] rounded-[8px] border border-[#d6d6d6] bg-white px-4 py-3 text-sm text-preto outline-none transition-colors placeholder:text-preto/45 focus:border-verde-3"
                                placeholder="" autocomplete="street-address"></textarea>
                            <span data-company-error="address" class="hidden text-sm font-medium text-[#c62828]"></span>
                        </label>
                    </div>
                </div>

                <div class="mt-10 flex flex-col gap-3 border-t border-[#d6d6d6] pt-10 sm:flex-row sm:items-center sm:justify-end">
                    <button type="submit" data-save-company
                        class="inline-flex h-12 items-center justify-center rounded-[8px] bg-verde px-6 text-sm font-semibold text-white transition-colors hover:bg-verde-2 disabled:cursor-not-allowed disabled:opacity-60">
                        Salvar alterações
                    </button>
                </div>
            </form>
        </main>
    </div>

    <script>
        window.__EMPRESA_SEED__ = <%- serializedSeed %>
    </script>
</body>

</html>
