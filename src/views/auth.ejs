<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesse a plataforma | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="min-h-screen !bg-white bg-white font-sans text-preto antialiased">
    <main class="grid min-h-screen bg-white xl:grid-cols-[minmax(480px,0.75fr)_minmax(0,1.25fr)]">
        <a href="/"
            class="absolute left-6 top-6 z-20 w-fit text-3xl font-marca font-normal text-verde sm:left-10 sm:top-8 lg:left-14 lg:top-12">
            gardesa
        </a>

        <section class="order-2 relative hidden min-h-screen overflow-hidden bg-preto xl:flex" aria-label="Gardesa">
            <img src="/img/foto_hero.png" alt="Ambiente de paisagismo com plantas e área externa"
                class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-preto/45"></div>
        </section>

        <section class="order-1 relative flex min-h-screen items-center justify-center bg-white px-6 pb-24 pt-20 sm:px-10 xl:px-14">
            <div class="w-full max-w-sm">
                <div class="mb-10">
                    <h2 class="text-3xl font-semibold leading-tight text-preto sm:text-4xl">
                        Acesse a plataforma
                    </h2>
                    <p class="mt-3 text-base font-light leading-relaxed text-preto/60">
                        Entre ou crie sua conta para continuar.
                    </p>
                </div>

                <% if (typeof authError !== 'undefined' && authError) { %>
                    <div class="mb-5 rounded-[8px] border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-600">
                        Não foi possível iniciar a autenticação. Tente novamente em instantes.
                    </div>
                <% } %>

                <a href="<%= googleAuthUrl %>"
                    class="flex h-11 w-full items-center justify-center gap-3 rounded-[4px] border border-[#dadce0] bg-white px-4 text-sm font-medium text-[#3c4043] shadow-sm transition-colors hover:bg-[#f8fafd] focus:outline-none focus:ring-2 focus:ring-azul/35 focus:ring-offset-2 focus:ring-offset-branco">
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.71v2.25h2.91c1.7-1.56 2.69-3.87 2.69-6.6z" />
                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.95-2.2l-2.91-2.25c-.81.54-1.84.86-3.04.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33A9 9 0 0 0 9 18z" />
                        <path fill="#FBBC05" d="M3.96 10.7A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.16.28-1.7V4.97H.96A9 9 0 0 0 0 9c0 1.45.35 2.82.96 4.03l3-2.33z" />
                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.57-2.57A8.62 8.62 0 0 0 9 0 9 9 0 0 0 .96 4.97l3 2.33C4.67 5.17 6.66 3.58 9 3.58z" />
                    </svg>
                    <span>Continuar com Google</span>
                </a>

                <p class="mt-5 text-center text-xs font-light leading-relaxed text-preto/50">
                    Ao continuar, você concorda com os <a href="/tos" class="font-medium text-verde underline underline-offset-2 transition-colors hover:text-verde-2">Termos de uso</a> e a <a href="/tos" class="font-medium text-verde underline underline-offset-2 transition-colors hover:text-verde-2">Política de privacidade.</a>
                </p>
            </div>

            <div class="absolute inset-x-6 bottom-6 flex flex-col gap-2 text-xs font-normal text-preto/60 sm:inset-x-10 sm:flex-row sm:items-center sm:justify-between xl:inset-x-14">
                <p>© 2026 Gardesa</p>
                <p class="sm:text-right">
                    Precisa de ajuda? <a href="mailto:suporte@gardesa.com.br" class="font-semibold text-verde underline underline-offset-2 transition-colors hover:text-verde-2">Fale com o suporte</a>
                </p>
            </div>
        </section>
    </main>
</body>

</html>
