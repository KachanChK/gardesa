                    <div class="faq-item border-b border-black/25 py-4">
                        <button onclick="toggleFaq(this)"
                            class="w-full flex items-center justify-between gap-4 text-left">
                            <span class="text-sm font-medium text-preto">Como faço para usar?</span>
