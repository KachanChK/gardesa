<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="<%= doc.baseUrl %>/" />
    <style><%- doc.inlineStyles %></style>
    <title><%= doc.budget.name || `Orçamento ${doc.budget.number}` %></title>
</head>

<body class="<%= doc.renderMode === 'preview' ? 'bg-[#e9efe4]' : 'bg-white' %> font-sans text-preto">
    <%
        const isPreview = doc.renderMode === 'preview'
        const hasPaymentConditions = Boolean(doc.budget.paymentConditions && doc.budget.paymentConditions.trim())
        const hasObservations = Boolean(doc.budget.observations && doc.budget.observations.trim())
        const hasBothFinalFields = hasPaymentConditions && hasObservations
        const mainClass = isPreview
            ? 'mx-auto flex w-full max-w-[980px] flex-col gap-8 px-6 py-10'
            : 'mx-auto w-[794px] bg-white'
        const pageClass = isPreview
            ? 'relative mx-auto flex h-[1123px] w-[794px] flex-col overflow-hidden rounded-[32px] border border-preto/10 bg-white px-14 py-14 shadow-[0_24px_70px_rgba(20,20,20,0.12)]'
            : 'relative box-border flex h-[1123px] flex-col overflow-hidden break-after-page px-14 py-14'
        const lastPageClass = isPreview
            ? pageClass
            : 'relative box-border flex h-[1123px] flex-col overflow-hidden px-14 py-14'
        const pageIndicatorClass = 'absolute right-14 top-7 text-base font-medium text-preto/60'
    %>

    <main class="<%= mainClass %>">
        <section class="<%= pageClass %>">
            <div class="grid grid-cols-[minmax(0,1fr)_minmax(240px,0.95fr)] gap-10">
                <div class="min-w-0">
                    <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Empresa</p>
                    <% if (doc.profile.logoUrl) { %>
                        <img src="<%= doc.profile.logoUrl %>" alt="Logo da empresa"
                            class="mt-5 h-32 w-auto max-w-[280px] object-contain object-left" />
                    <% } %>
                    <p class="<%= doc.profile.logoUrl ? 'mt-6' : 'mt-3' %> break-words text-[34px] font-semibold leading-tight text-preto">
                        <%= doc.profile.companyName %>
                    </p>
                </div>

                <div class="min-w-0 text-right">
                    <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Dados da empresa</p>
                    <div class="mt-3 space-y-3 text-base font-light leading-relaxed text-preto/70">
                        <p><%= doc.profile.email %></p>
                        <p><%= doc.profile.phone %></p>
                        <p><%= doc.profile.cnpj %></p>
                        <p><%= doc.profile.address %></p>
                    </div>
                </div>
            </div>

            <div class="flex flex-1 flex-col items-center justify-center text-center">
                <p class="text-base font-medium uppercase tracking-[0.24em] text-verde-2">Proposta comercial</p>
                <h1 class="mt-6 max-w-[620px] break-words px-6 text-[42px] font-semibold leading-[1.1] text-preto">
                    <%= doc.budget.name || 'Novo orçamento' %>
                </h1>
            </div>
        </section>

        <section class="<%= pageClass %>">
            <p class="<%= pageIndicatorClass %>">Página 2</p>

            <div class="mt-8">
                <p class="text-base font-medium uppercase tracking-[0.2em] text-verde-2">Dados do orçamento</p>
                <h2 class="mt-4 text-4xl font-semibold leading-tight text-preto">Informações principais</h2>
            </div>

            <div class="mt-10">
                <div class="min-w-0">
                    <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Cliente</p>
                    <p class="mt-4 break-words text-3xl font-semibold leading-tight text-preto">
                        <%= doc.client ? doc.client.name : 'Não informado' %>
                    </p>
                </div>
            </div>

            <div class="mt-8 border-t border-preto/10 pt-7">
                <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Descrição do projeto</p>
                <p class="mt-5 break-words text-[22px] font-light leading-relaxed text-preto/80">
                    <%= doc.budget.description || 'Nenhuma descrição adicional foi informada para este orçamento.' %>
                </p>
            </div>

            <div class="mt-auto flex items-end justify-between gap-6 border-t border-preto/10 pt-6">
                <div class="space-y-2 text-base font-light leading-relaxed text-preto/75">
                    <p><span class="font-medium text-preto">Empresa:</span> <%= doc.profile.companyName %></p>
                    <p><span class="font-medium text-preto">Contato:</span> <%= doc.profile.email %> · <%= doc.profile.phone %></p>
                </div>
                <% if (doc.profile.logoUrl) { %>
                    <img src="<%= doc.profile.logoUrl %>" alt="Logo da empresa" class="h-14 w-auto max-w-[180px] object-contain" />
                <% } %>
            </div>
        </section>

        <% doc.itemPages.forEach((itemsPage, pageIndex) => { const pageNumber = pageIndex + 3; const isLastItemsPage = pageIndex === doc.itemPages.length - 1; %>
            <section class="<%= pageClass %>">
                <p class="<%= pageIndicatorClass %>">Página <%= pageNumber %></p>

                <div class="mt-8">
                    <p class="text-base font-medium uppercase tracking-[0.2em] text-verde-2">Itens do orçamento</p>
                    <h2 class="mt-4 text-4xl font-semibold leading-tight text-preto">
                        Detalhamento dos itens
                    </h2>
                </div>

                <div class="mt-8 flex flex-1 flex-col">
                    <div class="border-y border-preto/10">
                        <% if (doc.budget.showValuesInPdf) { %>
                            <div class="grid grid-cols-[minmax(0,4.2fr)_72px_96px_138px] gap-4 bg-[#eef6e8] px-6 py-3 text-left text-sm font-semibold uppercase tracking-[0.12em] text-preto/55">
                                <span>Descrição</span>
                                <span>Qtd.</span>
                                <span>Unidade</span>
                                <span>Subtotal</span>
                            </div>

                            <% itemsPage.forEach((item, itemIndex) => { %>
                                <div class="<%= itemIndex % 2 === 0 ? 'bg-white' : 'bg-[#fafbf9]' %> grid grid-cols-[minmax(0,4.2fr)_72px_96px_138px] items-start gap-4 border-t border-preto/10 px-6 py-3 text-left text-[15px] text-preto">
                                    <div class="min-w-0">
                                        <p class="break-words font-semibold leading-relaxed text-preto"><%= item.description %></p>
                                    </div>
                                    <p class="pt-0.5 font-medium leading-relaxed text-preto/75"><%= item.quantityLabel %></p>
                                    <p class="pt-0.5 break-words font-medium leading-relaxed text-preto/75"><%= item.unitLabel %></p>
                                    <p class="pt-0.5 text-base font-semibold leading-relaxed text-preto"><%= item.subtotalLabel %></p>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="grid grid-cols-[minmax(0,5fr)_76px_110px] gap-4 bg-[#eef6e8] px-6 py-3 text-left text-sm font-semibold uppercase tracking-[0.12em] text-preto/55">
                                <span>Descrição</span>
                                <span>Qtd.</span>
                                <span>Unidade</span>
                            </div>

                            <% itemsPage.forEach((item, itemIndex) => { %>
                                <div class="<%= itemIndex % 2 === 0 ? 'bg-white' : 'bg-[#fafbf9]' %> grid grid-cols-[minmax(0,5fr)_76px_110px] items-start gap-4 border-t border-preto/10 px-6 py-3 text-left text-[15px] text-preto">
                                    <div class="min-w-0">
                                        <p class="break-words font-semibold leading-relaxed text-preto"><%= item.description %></p>
                                    </div>
                                    <p class="pt-0.5 font-medium leading-relaxed text-preto/75"><%= item.quantityLabel %></p>
                                    <p class="pt-0.5 break-words font-medium leading-relaxed text-preto/75"><%= item.unitLabel %></p>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <% if (isLastItemsPage) { %>
                        <div class="mt-6 max-w-[360px]">
                            <div class="text-left">
                                <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Valor total</p>
                                <p class="mt-4 text-4xl font-semibold leading-tight text-preto"><%= doc.totalLabel %></p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="mt-6 flex items-end justify-end gap-6 border-t border-preto/10 pt-6">
                    <% if (doc.profile.logoUrl) { %>
                        <img src="<%= doc.profile.logoUrl %>" alt="Logo da empresa" class="h-14 w-auto max-w-[180px] object-contain" />
                    <% } %>
                </div>
            </section>
        <% }) %>

        <section class="<%= lastPageClass %>">
            <p class="<%= pageIndicatorClass %>">Página <%= doc.pageCount %></p>

            <div class="mt-8">
                <p class="text-base font-medium uppercase tracking-[0.2em] text-verde-2">Pagamento e observações</p>
                <h2 class="mt-4 text-4xl font-semibold leading-tight text-preto">Condições finais</h2>
            </div>

            <div class="mt-10 grid gap-8 md:grid-cols-2">
                <div class="min-w-0">
                    <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Validade do orçamento</p>
                    <p class="mt-4 text-3xl font-semibold text-preto"><%= doc.validityLabel %></p>
                </div>

                <div class="min-w-0">
                    <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Formas de pagamento</p>
                    <% if (doc.paymentMethodLabels.length > 0) { %>
                        <div class="mt-4 flex flex-wrap gap-3">
                            <% doc.paymentMethodLabels.forEach((method) => { %>
                                <span class="inline-flex min-h-10 items-center border border-preto/10 px-4 py-2 text-base font-medium text-preto">
                                    <%= method %>
                                </span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="mt-4 text-base font-light leading-relaxed text-preto/75">
                            Nenhuma forma de pagamento foi informada.
                        </p>
                    <% } %>
                </div>
            </div>

            <% if (hasPaymentConditions || hasObservations) { %>
                <div class="mt-8 grid gap-8 border-t border-preto/10 pt-7 <%= hasBothFinalFields ? 'grid-cols-2' : 'grid-cols-1' %>">
                    <% if (hasPaymentConditions) { %>
                        <div class="min-w-0">
                            <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Condições</p>
                            <p class="mt-4 whitespace-pre-line break-words text-lg font-light leading-relaxed text-preto/80">
                                <%= doc.budget.paymentConditions %>
                            </p>
                        </div>
                    <% } %>

                    <% if (hasObservations) { %>
                        <div class="min-w-0">
                            <p class="text-sm font-medium uppercase tracking-[0.16em] text-preto/45">Observações gerais</p>
                            <p class="mt-4 whitespace-pre-line break-words text-lg font-light leading-relaxed text-preto/80">
                                <%= doc.budget.observations %>
                            </p>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <div class="mt-auto flex items-end justify-between gap-6 border-t border-preto/10 pt-6">
                <div class="space-y-2 text-base font-light leading-relaxed text-preto/75">
                    <p><span class="font-medium text-preto">Empresa:</span> <%= doc.profile.companyName %></p>
                    <p><span class="font-medium text-preto">Contato:</span> <%= doc.profile.email %> · <%= doc.profile.phone %></p>
                </div>
                <% if (doc.profile.logoUrl) { %>
                    <img src="<%= doc.profile.logoUrl %>" alt="Logo da empresa" class="h-14 w-auto max-w-[180px] object-contain" />
                <% } %>
            </div>
        </section>
    </main>
</body>

</html>
