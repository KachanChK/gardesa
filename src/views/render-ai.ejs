<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Render IA | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="stylesheet" href="/css/output.css" />
    <script src="/js/dashboard-shell.js" defer></script>
    <script src="/js/render-ai.js" defer></script>
</head>

<body class="min-h-screen bg-branco font-sans text-preto antialiased">
    <%
        const authenticatedUser = typeof currentUser !== 'undefined' ? currentUser : null
        const currentPage = 'Render IA'
        const navItems = [
            { label: 'Home', iconDefault: '/img/icons/inicio_default.svg', iconActive: '/img/icons/inicio_active.svg', active: false, href: '/member', iconSize: 'size-5' },
            { label: 'Render IA', iconDefault: '/img/icons/sparkles_black.svg', iconActive: '/img/icons/sparkles.svg', active: true, href: '/member/render', iconSize: 'size-5' },
            { label: 'Galeria', iconDefault: '/img/icons/layout_dark.svg', iconActive: '/img/icons/layout_green.svg', active: false, href: '/member/gallery', iconSize: 'size-5' }
        ]
    %>

    <div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" aria-hidden="true"></div>
    <%- include('partials/dashboard-sidebar', { navItems, currentUser: authenticatedUser }) %>

    <div id="dashboard-layout" class="min-h-screen transition-[padding] duration-300 md:pl-[240px]">
        <%- include('partials/dashboard-header', { sectionLabel: 'Dashboard', currentPage, currentUser: authenticatedUser }) %>

        <main class="mx-auto flex w-full max-w-[1540px] flex-col gap-5 px-4 py-5 sm:px-6 lg:px-8">
            <section class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_360px] 2xl:grid-cols-[minmax(0,1fr)_392px]">
                <div data-render-workspace class="flex min-h-[560px] flex-col gap-4 rounded-[8px] border border-[#e2e2e2] bg-white p-4 shadow-sm sm:p-5 lg:min-h-[calc(100vh-108px)] lg:p-6">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <h2 class="text-xl font-semibold leading-tight text-preto">Imagem do projeto</h2>
                            <p class="mt-1 text-sm font-light leading-relaxed text-preto/60">Envie uma imagem PNG ou JPG com ate 10 MB.</p>
                        </div>

                        <div data-render-compare-controls class="hidden items-center gap-3 rounded-full border border-[#e2e2e2] bg-white px-3 py-2">
                            <label class="flex cursor-pointer items-center gap-2 text-xs font-medium text-preto/70">
                                <input data-render-compare-checkbox type="checkbox" checked class="size-4 rounded border-[#bababa] accent-verde">
                                Comparar
                            </label>
                        </div>
                    </div>

                    <input data-render-file-input type="file" accept="image/png,image/jpeg" class="hidden">

                    <div class="relative flex min-h-[440px] flex-1 items-center justify-center overflow-hidden rounded-[8px] border border-dashed border-[#bababa] bg-[#f8f8f8] px-4 py-10 sm:px-8">
                        <div data-render-preview class="hidden h-full w-full flex-col items-center justify-center gap-4">
                            <div data-render-preview-frame class="relative max-h-[min(62vh,680px)] w-full max-w-[980px] overflow-hidden rounded-[8px] bg-white shadow-sm">
                                <img data-original-image src="" alt="Imagem do projeto" class="block max-h-[min(62vh,680px)] w-full object-contain" />
                                <div data-rendered-layer class="absolute inset-0 hidden overflow-hidden">
                                    <img data-rendered-image src="" alt="Render gerado com IA" class="h-full w-full object-contain" />
                                </div>
                                <span data-render-compare-handle class="pointer-events-none absolute inset-y-4 left-1/2 hidden w-px -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgba(20,20,20,0.15)]">
                                    <span class="absolute left-1/2 top-1/2 flex size-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white bg-preto text-xs font-semibold text-white shadow-lg">&harr;</span>
                                </span>
                                <input data-render-compare-range type="range" min="0" max="100" value="50" aria-label="Comparar imagem original e render" class="absolute inset-x-6 bottom-5 hidden h-1 cursor-ew-resize accent-verde">
                            </div>

                            <div class="flex w-full max-w-[980px] flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                <button data-render-upload-button type="button" class="inline-flex h-10 w-fit items-center justify-center rounded-full border border-[#e2e2e2] bg-white px-4 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]">
                                    Trocar imagem
                                </button>
                                <p data-render-status class="hidden text-sm font-light text-preto/60"></p>
                            </div>
                        </div>

                        <div data-render-empty-state class="flex w-full max-w-[460px] flex-col items-center text-center">
                            <span class="flex size-20 items-center justify-center rounded-full bg-[#f2f8ef]">
                                <img src="/img/icons/image_upload.svg" alt="" class="size-10" />
                            </span>

                            <p class="mt-6 text-base font-medium leading-relaxed text-preto">
                                Envie uma imagem clara do projeto 3D para gerar um render realista.
                            </p>

                            <button data-render-upload-button type="button" class="mt-6 inline-flex h-11 items-center justify-center rounded-full border border-[#e2e2e2] bg-white px-5 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]">
                                Enviar imagem
                            </button>

                            <p class="mt-3 text-sm font-light text-preto/50">PNG ou JPG, ate 10 MB</p>
                        </div>
                    </div>
                </div>

                <aside data-render-settings class="flex h-fit flex-col gap-6 rounded-[8px] border border-[#e2e2e2] bg-white p-5 shadow-sm xl:sticky xl:top-[88px]">
                    <div>
                        <p class="text-sm font-light text-preto/60">Render IA</p>
                        <h2 class="mt-1 text-xl font-semibold leading-tight text-preto">Configuracoes do render</h2>
                    </div>

                    <section class="flex flex-col gap-3" aria-labelledby="render-weather-title">
                        <h3 id="render-weather-title" class="text-sm font-semibold text-preto">Clima</h3>

                        <div class="grid gap-3 sm:grid-cols-3 xl:grid-cols-1">
                            <button data-weather-option="dia" type="button" class="flex min-h-[68px] items-center justify-between rounded-[8px] border border-[#e2e2e2] bg-white px-4 py-3 text-left transition-colors hover:bg-[#f3f3f3]">
                                <span>
                                    <span class="block text-sm font-semibold text-preto">Dia</span>
                                    <span class="mt-1 block text-xs font-light text-preto/55">Luz natural</span>
                                </span>
                                <span class="size-3 rounded-full bg-[#2ed218]"></span>
                            </button>

                            <button data-weather-option="noite" type="button" class="flex min-h-[68px] items-center justify-between rounded-[8px] border border-[#e2e2e2] bg-white px-4 py-3 text-left transition-colors hover:bg-[#f3f3f3]">
                                <span>
                                    <span class="block text-sm font-semibold text-preto">Noite</span>
                                    <span class="mt-1 block text-xs font-light text-preto/55">Luz artificial</span>
                                </span>
                                <span class="size-3 rounded-full bg-[#261F31]"></span>
                            </button>

                            <button data-weather-option="chuvoso" type="button" class="flex min-h-[68px] items-center justify-between rounded-[8px] border border-[#e2e2e2] bg-white px-4 py-3 text-left transition-colors hover:bg-[#f3f3f3]">
                                <span>
                                    <span class="block text-sm font-semibold text-preto">Chuvoso</span>
                                    <span class="mt-1 block text-xs font-light text-preto/55">Cena umida</span>
                                </span>
                                <span class="size-3 rounded-full bg-azul"></span>
                            </button>
                        </div>
                    </section>

                    <section class="flex flex-col gap-4" aria-labelledby="render-quality-title">
                        <div class="flex items-center justify-between">
                            <h3 id="render-quality-title" class="text-sm font-semibold text-preto">Qualidade</h3>
                            <span class="text-xs font-light text-preto/50">Resolucao</span>
                        </div>

                        <input data-quality-range type="range" min="1" max="3" step="1" value="2" aria-label="Qualidade do render" class="h-1 w-full cursor-pointer accent-verde">

                        <div class="grid grid-cols-3 gap-2">
                            <span data-quality-label="1K" class="flex h-8 items-center justify-center rounded-full bg-[#f3f3f3] text-xs font-semibold text-preto/55">1K</span>
                            <span data-quality-label="2K" class="flex h-8 items-center justify-center rounded-full bg-preto text-xs font-semibold text-white">2K</span>
                            <span data-quality-label="4K" class="flex h-8 items-center justify-center rounded-full bg-[#f3f3f3] text-xs font-semibold text-preto/55">4K</span>
                        </div>
                    </section>

                    <div class="flex flex-col gap-3">
                        <p data-render-error class="hidden rounded-[8px] border border-[#f1b8b8] bg-[#fff5f5] px-3 py-2 text-sm font-medium text-[#b42318]"></p>
                        <p data-render-progress class="hidden text-center text-sm font-light text-preto/60"></p>

                        <button data-render-generate type="button" class="inline-flex h-12 w-full items-center justify-center gap-3 rounded-full bg-verde px-5 text-sm font-semibold text-white shadow-md shadow-verde/25 transition-colors hover:bg-verde-2">
                            <span class="flex size-7 items-center justify-center rounded-full bg-white">
                                <img src="/img/icons/sparkles.svg" alt="" class="size-4" />
                            </span>
                            <span data-render-button-label>Gerar render</span>
                        </button>
                    </div>
                </aside>
            </section>
        </main>
    </div>
</body>

</html>
