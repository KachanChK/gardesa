<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Início | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="min-h-screen bg-branco font-sans text-preto antialiased">
    <%
        const currentPage = 'Início'
        const recentBudgets = Array.from({ length: 6 }, () => ({
            name: 'Lorem ipsum is simply dummy text of the printing and types...',
            client: 'Eduarda Ranzani',
            value: 'R$999.999',
            createdAt: '17/07/25',
            status: 'Rascunho'
        }))

        const navItems = [
            { label: 'Início', icon: '/img/icons/inicio_icon.svg', active: true, href: '/inicio', iconSize: 'size-5' },
            { label: 'Orçamentos', icon: '/img/icons/orcamentos_icon.svg', active: false, href: '#orcamentos', iconSize: 'size-5' },
            { label: 'Clientes', icon: '/img/icons/clientes_icon.svg', active: false, href: '#clientes', iconSize: 'size-5' },
            { label: 'Empresa', icon: '/img/icons/empresa_icon.svg', active: false, href: '#empresa', iconSize: 'size-5' }
        ]

        const metrics = [
            { label: 'Orçamentos', value: '24', hint: '6 recentes', color: 'bg-[#d1fac8] text-[#2ed218]' },
            { label: 'Clientes', value: '18', hint: '2 novos', color: 'bg-[#fff1df] text-laranja' },
            { label: 'Rascunhos', value: '6', hint: 'em aberto', color: 'bg-[#f0f0f0] text-preto' },
            { label: 'Valor previsto', value: 'R$ 42.350', hint: 'este mês', color: 'bg-[#d1fac8] text-[#2ed218]' }
        ]
    %>

    <div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" aria-hidden="true"></div>

    <aside id="dashboard-sidebar"
        class="fixed inset-y-0 -left-[260px] z-50 flex w-[260px] flex-col border-r border-[#e2e2e2] bg-white shadow-lg transition-all duration-300 md:left-0 md:shadow-none">
        <div class="flex h-[68px] items-center gap-3 border-b border-[#e2e2e2] px-5">
            <span data-sidebar-label class="text-2xl text-verde font-regular leading-none">gardesa</span>
        </div>

        <nav class="flex flex-1 flex-col gap-1 px-3 py-5" aria-label="Navegação principal">
            <% navItems.forEach((item) => { %>
                <a href="<%= item.href %>" data-nav-link
                    class="group flex h-11 items-center justify-start gap-3 rounded-[8px] px-3 text-sm font-medium transition-colors <%= item.active ? 'bg-[#d1fac8] text-[#2ed218]' : 'text-preto/70 hover:bg-[#f3f3f3] hover:text-preto' %>"
                    aria-current="<%= item.active ? 'page' : 'false' %>">
                    <span
                        class="flex size-8 shrink-0 items-center justify-center rounded-[8px] <%= item.active ? 'bg-white/70' : 'bg-transparent' %>">
                        <img src="<%= item.icon %>" alt="" class="<%= item.iconSize %> object-contain" />
                    </span>
                    <span data-sidebar-label class="truncate"><%= item.label %></span>
                </a>
            <% }) %>
        </nav>

        <div class="border-t border-[#e2e2e2] p-3">
            <div data-nav-link class="flex h-12 items-center justify-start gap-3 rounded-[8px] px-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-[#bababa]/70 bg-[#d9d9d9]">
                    <span class="size-4 rounded-full bg-white/60"></span>
                </span>
                <div data-sidebar-label class="min-w-0">
                    <p class="truncate text-sm font-medium text-preto">Perfil</p>
                </div>
            </div>
        </div>
    </aside>

    <div id="dashboard-layout" class="min-h-screen transition-[padding] duration-300 md:pl-[260px]">
        <header
            class="sticky top-0 z-30 flex h-[68px] items-center justify-between border-b border-[#e2e2e2] bg-white/95 px-4 backdrop-blur sm:px-6 lg:px-8">
            <div class="flex min-w-0 items-center gap-4">
                <button id="sidebar-toggle" type="button"
                    class="flex size-10 shrink-0 items-center justify-center rounded-full border border-[#e2e2e2] bg-white text-preto transition-colors hover:bg-[#f3f3f3]"
                    aria-label="Abrir ou fechar menu lateral">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" />
                    </svg>
                </button>
                <div class="h-7 w-px bg-[#e2e2e2]"></div>
                <div class="min-w-0">
                    <h1 class="mt-1 truncate text-lg font-semibold leading-none text-preto"><%= currentPage %></h1>
                </div>
            </div>
        </header>

        <main class="mx-auto flex w-full max-w-[1280px] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
            <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <h2 class="mt-1 text-2xl font-semibold leading-tight text-preto sm:text-3xl">Visão geral</h2>
                </div>
            </section>

            <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumo">
                <% metrics.forEach((metric) => { %>
                    <article class="rounded-[8px] border border-[#e2e2e2] bg-white p-5 shadow-sm">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="text-sm font-light text-preto/60"><%= metric.label %></p>
                                <p class="mt-3 text-2xl font-semibold leading-none text-preto"><%= metric.value %></p>
                            </div>
                            <span class="rounded-full px-3 py-1 text-xs font-medium <%= metric.color %>">
                                <%= metric.hint %>
                            </span>
                        </div>
                    </article>
                <% }) %>
            </section>

            <section id="orcamentos" class="rounded-[8px] border border-[#e2e2e2] bg-white shadow-sm">
                <div class="flex flex-col gap-3 border-b border-[#e2e2e2] px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                    <div>
                        <h2 class="text-xl font-semibold leading-tight text-preto">Orçamentos recentes</h2>
                    </div>
                    <a href="#"
                        class="inline-flex h-9 w-fit items-center justify-center rounded-full border border-[#e2e2e2] px-4 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]">
                        Ver todos
                    </a>
                </div>

                <div class="w-full overflow-x-auto">
                    <div class="min-w-[860px]">
                        <div
                            class="grid h-11 grid-cols-[330px_170px_120px_105px_130px_80px] items-center bg-[#d1fac8] px-5 text-sm font-medium text-preto">
                            <span>Nome</span>
                            <span>Cliente</span>
                            <span>Valor</span>
                            <span>Criado</span>
                            <span>Status</span>
                            <span class="sr-only">Ações</span>
                        </div>

                        <% recentBudgets.forEach((budget) => { %>
                            <div
                                class="grid min-h-[60px] grid-cols-[330px_170px_120px_105px_130px_80px] items-center border-b border-[#e2e2e2] px-5 text-sm text-preto last:border-b-0">
                                <p class="truncate pr-5 font-medium"><%= budget.name %></p>
                                <p class="truncate pr-3 font-normal"><%= budget.client %></p>
                                <p class="font-normal"><%= budget.value %></p>
                                <p class="font-normal"><%= budget.createdAt %></p>
                                <span
                                    class="flex h-[22px] w-[96px] items-center justify-center rounded-full bg-[rgba(168,165,172,0.6)] text-xs font-medium leading-none text-white shadow-[1px_1px_4px_0px_rgba(0,0,0,0.18)]">
                                    <%= budget.status %>
                                </span>
                                <div class="flex items-center justify-end gap-4">
                                    <a href="#" aria-label="Baixar orçamento" class="transition-opacity hover:opacity-70">
                                        <img src="/img/icons/download_icon.svg" alt="" class="size-5" />
                                    </a>
                                    <a href="#" aria-label="Deletar orçamento" class="transition-opacity hover:opacity-70">
                                        <img src="/img/icons/deletar_icon.svg" alt="" class="size-5" />
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script>
        const sidebar = document.getElementById('dashboard-sidebar')
        const layout = document.getElementById('dashboard-layout')
        const overlay = document.getElementById('sidebar-overlay')
        const toggle = document.getElementById('sidebar-toggle')
        const labels = document.querySelectorAll('[data-sidebar-label]')
        const navLinks = document.querySelectorAll('[data-nav-link]')
        let collapsed = false

        function isDesktop() {
            return window.matchMedia('(min-width: 768px)').matches
        }

        function setMobileMenu(open) {
            sidebar.classList.toggle('-left-[260px]', !open)
            sidebar.classList.toggle('left-0', open)
            overlay.classList.toggle('hidden', !open)
        }

        function setCollapsed(value) {
            collapsed = value
            sidebar.classList.toggle('w-[84px]', collapsed)
            sidebar.classList.toggle('w-[260px]', !collapsed)
            layout.classList.toggle('md:pl-[84px]', collapsed)
            layout.classList.toggle('md:pl-[260px]', !collapsed)

            labels.forEach((label) => {
                label.classList.toggle('md:hidden', collapsed)
            })

            navLinks.forEach((link) => {
                link.classList.toggle('md:justify-center', collapsed)
                link.classList.toggle('md:px-0', collapsed)
                link.classList.toggle('md:justify-start', !collapsed)
                link.classList.toggle('md:px-3', !collapsed)
            })
        }

        toggle.addEventListener('click', () => {
            if (isDesktop()) {
                setCollapsed(!collapsed)
            } else {
                setMobileMenu(sidebar.classList.contains('-left-[260px]'))
            }
        })

        overlay.addEventListener('click', () => setMobileMenu(false))

        window.addEventListener('resize', () => {
            if (isDesktop()) {
                setMobileMenu(false)
            } else {
                setCollapsed(false)
            }
        })
    </script>
</body>

</html>
