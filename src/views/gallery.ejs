<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Galeria | Gardesa</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico?=5">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/output.css" />
    <script src="/js/dashboard-shell.js" defer></script>
    <script src="/js/gallery.js" defer></script>
</head>

<body class="min-h-screen bg-[#fafafa] font-sans text-preto antialiased">
    <%
        const authenticatedUser = typeof currentUser !== 'undefined' ? currentUser : null
        const currentPage = 'Galeria'
        const navItems = [
            { label: 'Home', iconDefault: '/img/icons/inicio_default.svg', iconActive: '/img/icons/inicio_active.svg', active: false, href: '/member', iconSize: 'size-5' },
            { label: 'Renderizar Imagem', iconDefault: '/img/icons/sparkles_black.svg', iconActive: '/img/icons/sparkles.svg', active: false, href: '/member/render', iconSize: 'size-5' },
            { label: 'Galeria', iconDefault: '/img/icons/layout_dark.svg', iconActive: '/img/icons/layout_green.svg', active: true, href: '/member/gallery', iconSize: 'size-5' }
        ]
    %>

    <div id="sidebar-overlay" class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" aria-hidden="true"></div>
    <%- include('partials/dashboard-sidebar', { navItems, currentUser: authenticatedUser, initialSidebarCollapsed: true }) %>

    <div id="dashboard-layout" class="min-h-screen pl-[84px] transition-[padding] duration-300">
        <%- include('partials/dashboard-header', { sectionLabel: 'Dashboard', currentPage, currentUser: authenticatedUser }) %>

        <main class="min-h-[calc(100vh-68px)] bg-[#fafafa] px-4 pb-12 pt-8 sm:px-8">
            <section class="mx-auto w-full max-w-[1292px]" aria-labelledby="gallery-title">
                <h2 data-gallery-title id="gallery-title" class="text-[28px] font-semibold leading-[34px] text-preto">Galeria - Todos</h2>
                <p class="mt-1 text-base font-medium leading-[18px] text-preto/55">Seu hist&oacute;rico de projetos e cria&ccedil;&otilde;es.</p>

                <div class="mt-4 flex items-center gap-2">
                    <button data-gallery-tab="all" type="button" class="inline-flex h-[42px] min-w-[88px] items-center justify-center rounded-full border border-preto bg-preto px-6 text-sm font-medium text-white transition-colors" aria-pressed="true">
                        Todos
                    </button>
                    <button data-gallery-tab="favorites" type="button" class="inline-flex h-[42px] min-w-[112px] items-center justify-center rounded-full border border-[#d9d9d9] bg-white px-6 text-sm font-medium text-preto transition-colors hover:bg-[#f3f3f3]" aria-pressed="false">
                        Favoritos
                    </button>
                </div>

                <p data-gallery-error class="mt-6 hidden rounded-[8px] border border-[#f1b8b8] bg-[#fff5f5] px-4 py-3 text-sm font-medium text-[#b42318]"></p>

                <div data-gallery-grid class="mt-[34px] grid justify-start gap-x-[22px] gap-y-6 [grid-template-columns:repeat(auto-fill,minmax(min(100%,236px),236px))]"></div>

                <div data-gallery-empty class="mx-auto mt-20 hidden w-full max-w-[360px] flex-col items-center text-center">
                    <img src="/img/icons/image.svg" alt="" class="size-12 opacity-70" />
                    <p class="mt-4 text-lg font-semibold leading-6 text-preto">Nenhum render encontrado</p>
                    <p data-gallery-empty-copy class="mt-2 text-sm font-normal leading-5 text-preto/55">Quando voc&ecirc; gerar renders, eles aparecer&atilde;o aqui.</p>
                </div>

                <div data-gallery-loader class="flex h-20 items-center justify-center">
                    <span class="size-8 animate-spin rounded-full border-2 border-[#e2e2e2] border-t-verde" aria-label="Carregando"></span>
                </div>

                <div data-gallery-sentinel class="h-px w-full" aria-hidden="true"></div>
            </section>
        </main>
    </div>

    <%- include('partials/gallery-overlays') %>
</body>

</html>
